# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` — it is gitignored.

# Required: your WakaTime API key from https://wakatime.com/api-key
WAKATIME_API_KEY=

# Optional: GitHub token for higher API rate limits.
# In GitHub Actions, use the built-in token (github.token) instead.
GITHUB_TOKEN=

# Optional: allowlists public WakaTime projects and maps them to GitHub
# "owner/repo" slugs. Unmapped project names are never published.
# Must be valid JSON, e.g.:
# {"my-app":"myusername/my-app","other-project":"myusername/other-project"}
CURRENT_PROJECT_MAPPING=

# Optional: paths to local clones of your repos, used by ManifestReader
# to detect frameworks/tools from package.json, Cargo.toml, etc.
# Must be a JSON array of absolute paths. Example:
# ["/home/you/repos/repo1","/home/you/repos/repo2"]
# Note: only works when running locally. GitHub Actions runners
# don't have access to your local filesystem.
LOCAL_REPOS_PATHS=
